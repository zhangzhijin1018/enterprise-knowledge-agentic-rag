# 基础应用配置
APP_NAME=Enterprise Knowledge Agentic RAG Platform
APP_ENV=local
APP_DEBUG=false
API_PREFIX=/api/v1
OPENAPI_URL=/openapi.json

# 基础基础设施配置示例
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/enterprise_rag
REDIS_URL=redis://localhost:6379/0
MILVUS_URI=http://localhost:19530

# =============================================================================
# vLLM Qwen-32B 模型部署配置
# =============================================================================
# 如果你使用 vLLM 部署 Qwen-32B，按如下配置
#
# 部署步骤：
# 1. 安装 vLLM: pip install vllm
# 2. 下载模型: huggingface-cli download Qwen/Qwen2.5-32B-Instruct
# 3. 启动服务: python -m vllm.entrypoints.openai.api_server --model Qwen/Qwen2.5-32B-Instruct --port 8000
# 4. 配置下方环境变量

LLM_PROVIDER=vllm
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL_NAME=Qwen/Qwen2.5-32B-Instruct
LLM_TIMEOUT_SECONDS=120

# 如果使用其他模型，调整 LLM_MODEL_NAME：
# LLM_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct
# LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# =============================================================================
# 如果你使用 Ollama，按如下配置
# =============================================================================
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL_NAME=qwen2.5:32b

# =============================================================================
# 经营分析局部 ReAct Planner 配置
# =============================================================================
# 默认关闭：简单问题继续走确定性 Planner；复杂问题在显式开启后才调用 LLM Gateway。
ANALYTICS_REACT_PLANNER_ENABLED=false
ANALYTICS_REACT_MAX_STEPS=3

# 经营分析 LLM 槽位补强配置
# 默认关闭：规则 Planner 与 SlotValidator 仍是主链；开启后也只能补槽位，不能生成 SQL。
ANALYTICS_PLANNER_ENABLE_LLM_FALLBACK=false
ANALYTICS_PLANNER_LLM_MODEL=qwen2.5-14b-instruct

# 默认 LLM 模型（用于评估等）
DEFAULT_LLM_MODEL=Qwen/Qwen2.5-32B-Instruct
